# .env.example
# Copy this to .env and fill in real values
# NEVER commit the actual .env file

# ==============================================================================
# API KEYS (REQUIRED)
# ==============================================================================

# SerpAPI Key - Get from https://serpapi.com/
SERP_API_KEY=your_serpapi_key_here

# ==============================================================================
# AWS CONFIGURATION (REQUIRED)
# ==============================================================================

# AWS Profile name from ~/.aws/credentials
AWS_PROFILE=your_aws_profile

# AWS Region for Bedrock
AWS_REGION=us-east-1

# Bedrock Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ==============================================================================
# APPLICATION SETTINGS (Optional - defaults provided)
# ==============================================================================

# Maximum image size in MB
MAX_IMAGE_SIZE_MB=10

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum retry attempts for failed requests
MAX_RETRIES=3

# Rate limit per minute
RATE_LIMIT_PER_MINUTE=60

# ==============================================================================
# LOGGING
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# ENVIRONMENT
# ==============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# ==============================================================================
# DATABASE
# ==============================================================================

# Path to player database JSON file (relative to project root)
# Default: data/db/cfl_players.json
#PLAYER_DB_PATH=data/db/cfl_players.json

# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================
# 
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual API keys and AWS credentials
#
# 3. Set proper permissions (Unix/Linux/Mac):
#    chmod 600 .env
#
# 4. Verify .env is in .gitignore:
#    grep "^\.env$" .gitignore
#
# 5. Install git hooks to prevent accidental commits:
#    bash scripts/setup_git_hooks.sh
#
# ==============================================================================
